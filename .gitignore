# Local CLI workspace: event log and plan history
.krama/
web/node_modules/

# Terraform. The bootstrap stack keeps its state locally and it names the account.
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions and
# their hashes, which is the same argument as pinning the travel snapshot.
*.tfstate
*.tfstate.*
.terraform/
crash.log

# OSM source extracts and the built road network. Large, reproducible from
# scripts/setup_osrm.sh, and not something to put in a repository.
docker/osrm/data/

# Live workspaces and the account store: event logs, plans, session secrets,
# password hashes. State, never source.
.krama*/
shops/
